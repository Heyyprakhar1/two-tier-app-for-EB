# Flask Application Configuration
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-key-in-production
FLASK_DEBUG=0

# Database Configuration
# Defaults to 127.0.0.1 for self-contained single-container operation (zero-config).
# If connecting to an external database (e.g. Amazon RDS), specify the endpoint here:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=devops_dashboard
MYSQL_USER=dashboard
MYSQL_PASSWORD=dashboard123
MYSQL_ROOT_PASSWORD=rootpassword123
